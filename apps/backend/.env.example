# Database
DATABASE_URL=postgresql://cartulary:changeme@postgres:5432/cartulary

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Storage
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=/data/documents

# Authentication
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application
APP_NAME=Cartulary
DEBUG=true
API_V1_PREFIX=/api/v1

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:8080"]

# Vision OCR (Phase 2 - LLM-based text extraction, two-pass)
OCR_ENABLED=false
VISION_OCR_MODEL=minicpm-v  # Pass 1: Ollama vision model for text extraction (uses LLM_BASE_URL)
OCR_FORMATTER_MODEL=qwen2.5:7b-instruct-q4_K_M  # Pass 2: Ollama text model that formats pass-1 output as markdown (uses LLM_BASE_URL)
OCR_PAGE_CONCURRENCY=1  # PDF pages OCR'd at once; raise only as far as the model server serves in parallel
OCR_PAGE_CACHE_ENABLED=true  # Remember each page's OCR text in Redis, keyed by page image and models
OCR_PAGE_CACHE_TTL_SECONDS=2592000  # How long a remembered page stays cached (30 days)

# Model requests (all roles)
MODEL_TIMEOUT_SECONDS=300  # A model request silent for this long fails as a model error

# Embeddings (Phase 3)
# Embedder: chunk and query embedding. False means no embedder, so the endpoints
# that need one answer 503 (ADR 0003).
EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=ollama  # local, openai, ollama
EMBEDDING_MODEL=nomic-embed-text  # For local: all-MiniLM-L6-v2, For OpenAI: text-embedding-3-small, For Ollama: nomic-embed-text
EMBEDDING_DIMENSION=768  # 384 for MiniLM, 768 for nomic-embed-text, 1536 for OpenAI
EMBEDDING_CHUNK_SIZE=500
EMBEDDING_CHUNK_OVERLAP=50
# Required if EMBEDDING_PROVIDER=openai or LLM_PROVIDER=openai
OPENAI_API_KEY=

# LLM (Phase 4 - Optional)
# Powers both metadata extraction and RAG chat. False means metadata extraction is
# skipped and the chat API returns 503; set true if you use chat.
LLM_ENABLED=false
LLM_PROVIDER=ollama
LLM_MODEL=llama2
LLM_BASE_URL=http://localhost:11434
# Required if LLM_PROVIDER=gemini; LLM_PROVIDER=openai reads the OPENAI_API_KEY above
GEMINI_API_KEY=

# OIDC (Phase 7 - Optional)
OIDC_ENABLED=false
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Frontend callback URL
OIDC_REDIRECT_URI=http://localhost:8080/auth/callback

# Import Sources (Phase 6)
WATCH_DIRECTORIES=[]
IMAP_ENABLED=false
IMAP_SERVER=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_PROCESSED_FOLDER=Processed
